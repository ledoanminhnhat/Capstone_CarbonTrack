# Copy file này thành ".env.properties" rồi điền connection string thật vào.
# Lưu ý: nếu mật khẩu có ký tự đặc biệt (* ! @ #...) phải mã hóa URL:
#   *  -> %2A     @ -> %40     #  -> %23     !  -> %21
spring.data.mongodb.uri=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/carbontrack?retryWrites=true&w=majority

# Cloudinary (upload ảnh Community) - lấy ở Cloudinary Console > Settings > API Keys
cloudinary.cloud-name=<cloud-name>
cloudinary.api-key=<api-key>
cloudinary.api-secret=<api-secret>

# Google login - OAuth Client ID (Google Cloud > Credentials)
google.client-id=<client-id>.apps.googleusercontent.com

# Gửi mail (quên mật khẩu) qua Brevo - lấy ở Brevo > SMTP & API > API Keys
brevo.api-key=<xkeysib-...>
